{
  "name": "@g57651/dsh-session-manager",
  "version": "0.3.6",
  "description": "Web 侧边栏会话管理面板 + 会话资源生命周期管理器：全部 / 已归档 / 已删除视图、批量管理，以及 Baseline / Change Journal / Cleanup Engine 驱动的资源回滚。",
  "type": "module",
  "main": "./index.js",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./package.json": "./package.json"
  },
  "files": [
    "index.js",
    "session-manage.js",
    "lifecycle",
    "client.js",
    "cordis.patch.yml",
    "icon.svg",
    "README.md",
    "package.json"
  ],
  "keywords": [
    "deepseek-harness",
    "dsh",
    "dsh-plugin",
    "session",
    "web-ui"
  ],
  "license": "MIT",
  "icon": "./icon.svg",
  "engines": {
    "node": "^22.19 || >=24",
    "dsh": ">=0.1.7-rc.0"
  },
  "dependencies": {},
  "peerDependencies": {
    "@deepseek-ai/schemastery": "^3.18.3"
  },
  "devDependencies": {
    "@deepseek-ai/schemastery": "^3.18.3"
  },
  "dsh": {
    "manifestVersion": 1,
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-connection",
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-layout",
        "@deepseek-ai/dsh-client-ui-sidebar",
        "@deepseek-ai/dsh-api-remotes"
      ],
      "external": []
    }
  }
}
